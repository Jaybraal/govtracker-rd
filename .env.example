# ─── Base de datos ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://govtracker:govtracker2024@db:5432/govtracker_rd
DATABASE_URL_ASYNC=postgresql+asyncpg://govtracker:govtracker2024@db:5432/govtracker_rd

# ─── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ─── IA (opcional) ────────────────────────────────────────────────────────────
# Ollama corre localmente en tu PC (no dentro de Docker)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3

# Si quieres usar OpenAI o Claude en vez de Ollama:
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ─── Seguridad ────────────────────────────────────────────────────────────────
SECRET_KEY=cambia-esto-en-produccion-usa-openssl-rand-hex-32

# ─── Scrapers ─────────────────────────────────────────────────────────────────
SCRAPER_DELAY=1.5
SCRAPER_MAX_RETRIES=3

# ─── Alertas ──────────────────────────────────────────────────────────────────
ALERT_CONTRACT_THRESHOLD=100000000
ALERT_COMPANY_CONTRACT_COUNT=20
ALERT_ADDENDUM_COUNT=3
ALERT_PRICE_INCREASE_PCT=25.0

# ─── Debug ────────────────────────────────────────────────────────────────────
DEBUG=true
